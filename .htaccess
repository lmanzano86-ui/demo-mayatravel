# Enlaces cortos de Maya Travel Company -> ViajeReady
# RewriteRule con QSA: deja pasar los parámetros (p. ej. el token ?t= del conductor)
RewriteEngine On
RewriteRule ^reservas/?$ https://viajeready.newageprosystem.com/reservas-maya-travel.html [R=302,L,QSA]
RewriteRule ^mis-reservas/?$ https://viajeready.newageprosystem.com/mis-reservas.html?tenant=maya-travel [R=302,L,QSA]
RewriteRule ^pagar/?$ https://viajeready.newageprosystem.com/pagar.html?tenant=maya-travel [R=302,L,QSA]
RewriteRule ^rastrear/?$ https://viajeready.newageprosystem.com/rastrear.html [R=302,L,QSA]
RewriteRule ^portal/?$ https://viajeready.newageprosystem.com/portal.html [R=302,L,QSA]
RewriteRule ^conductor/?$ https://viajeready.newageprosystem.com/conductor.html [R=302,L,QSA]
RewriteRule ^invitacion/?$ https://viajeready.newageprosystem.com/invite.html [R=302,L,QSA]
